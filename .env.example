# Copiar a .env. Generar SECRET_KEY con el comando del README.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# PostgreSQL en nube: conservar sslmode=require. No subir credenciales.
DATABASE_URL=
MONGODB_URI=
MONGODB_DATABASE=nuam
# Solo para demostración local sin PostgreSQL; no acredita integración.
USE_SQLITE=false
# Solo en localhost HTTP. En un servidor HTTPS: true.
SECURE_COOKIES=false
